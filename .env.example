# Copy this file to .env and fill in your own keys. Never commit .env.

# Exa (web research). Sign up at https://exa.ai and create a key in the dashboard.
EXA_API_KEY=

# Groq (LLM synthesis). Create a key at https://console.groq.com
GROQ_API_KEY=
# Model: llama-3.3-70b-versatile was shut down on 16 Aug 2026. Groq recommends openai/gpt-oss-120b (alternative: qwen/qwen3.6-27b).
GROQ_MODEL=openai/gpt-oss-120b

# Enrichment: none (default, MoltSets skipped per Outmate), mock, or moltsets (key looks like ms_XXXXXXXX).
ENRICHMENT_PROVIDER=none
MOLTSETS_API_KEY=
MOLTSETS_BASE_URL=https://api.moltsets.com/api/v1/tools

# Frontend origin allowed by backend CORS
FRONTEND_ORIGIN=http://localhost:3000
